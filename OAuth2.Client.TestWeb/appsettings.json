{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OAuth2Clients": {
    "OAuth2.Client.For.Google,OAuth2.Client": {
      "ClientID"    : "--- From appsettings.secret.json ---",
      "ClientSecret": "--- From appsettings.secret.json ---",
      "Scope"       : "profile email",
      "RedirectURI" : "https://localhost/By/Google"
    },
    "OAuth2.Client.For.Yandex,OAuth2.Client": {
      "ClientID"    : "--- From appsettings.secret.json ---",
      "ClientSecret": "--- From appsettings.secret.json ---",
      "Scope"       : "login:email login:info login:avatar",
      "RedirectURI" : "https://localhost/By/Yandex"
    },
    "OAuth2.Client.For.MicrosoftLive,OAuth2.Client": {
      "ClientID"    : "--- From appsettings.secret.json ---",
      "ClientSecret": "--- From appsettings.secret.json ---",
      "Scope"       : "User.Read profile email openid",
      "RedirectURI" : "https://localhost/By/MicrosoftLive"
    },
    "OAuth2.Client.For.GitHub,OAuth2.Client": {
      "ClientID"    : "--- From appsettings.secret.json ---",
      "ClientSecret": "--- From appsettings.secret.json ---",
      "Scope"       : "read:user user:email",
      "RedirectURI" : "https://localhost/By/GitHub"
    },
    "OAuth2.Client.For.VK,OAuth2.Client": {
      "ClientID"    : "--- From appsettings.secret.json ---",
      "ClientSecret": "--- From appsettings.secret.json ---",
      "Scope"       : "email",
      "RedirectURI" : "https://localhost/By/VK"
    },
    "OAuth2.Client.For.VKID,OAuth2.Client": {
      "ClientID"    : "--- From appsettings.secret.json ---",
      "ClientSecret": "--- From appsettings.secret.json ---",
      "OptionsType" : "OAuth2.Client.Models.VKIDOptions,OAuth2.Client",
      "Scope"       : "email",
      "usePublicInfo": false,
      "RedirectURI" : "https://localhost/By/VKID"
    },
    "OAuth2.Client.For.Stogramm,OAuth2.Client": {
      "ClientID"    : "--- From appsettings.secret.json ---",
      "ClientSecret": "--- From appsettings.secret.json ---",
      "Scope"       : "read:accounts",
      "RedirectURI" : "https://localhost/By/Stogramm"
    },
    "OAuth2.Client.For.Keycloak,OAuth2.Client": {
      "ClientID"    : "--- From appsettings.secret.json ---",
      "ClientSecret": "--- From appsettings.secret.json ---",
      "Scope"       : "openid",
      "OptionsType" : "OAuth2.Client.Models.KeycloakOptions,OAuth2.Client",
      "Name"        : "Keycloak",
      "BaseURI"     : "--- From appsettings.secret.json ---",
      "IDField"     : "sub",
      "RedirectURI" : "https://localhost/By/Keycloak"
    },
    "OAuth2.Client.TestWeb.Services.FakeClient,OAuth2.Client.TestWeb": {
      "ClientID"    : "Fake-ID",
      "ClientSecret": "Fake-Secret",
      "Scope"       : "fake:profile fake:email",
      "RedirectURI" : "https://localhost/By/FakeClient"
    }
  }
}
